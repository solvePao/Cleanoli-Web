---
import appIcon from '../../assets/4A035189-C821-4892-B2C4-FE461C30127B.png';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Cleanoli — Disk Cleaner & Storage Manager for macOS',
  description = 'Clean disk clutter, understand storage, and manage space on your Mac with review-first controls.',
  canonicalPath = '/',
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, 'https://cleanoli.solvepao.com').toString();
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="Cleanoli — Disk Cleaner & Storage Manager for macOS" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cleanoli" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="any" href={appIcon.src} />
    <link rel="shortcut icon" type="image/png" href={appIcon.src} />
    <link rel="apple-touch-icon" href={appIcon.src} />
  </head>
  <body>
    <slot />
    <footer>
      <div class="footer-inner">
        <div class="footer-brand-col">
          <span class="footer-brand">
            <img src={appIcon.src} alt="" width="24" height="24" />
            Cleanoli
          </span>
          <p class="footer-tagline">A product of SolvePao Research.</p>
        </div>
        <div class="footer-links-col">
          <span class="footer-heading">Links</span>
          <a href="/#download-options">Install</a>
          <a href="/#features">Features</a>
          <a href="/support">Support</a>
          <a href="/privacy/">Privacy</a>
          <a href="https://github.com/solvePao/Cleanoli-Web/releases">Releases</a>
          <a href="https://github.com/solvePao/homebrew-tap">Homebrew</a>
          <a href="https://github.com/solvePao/Cleanoli-Web">GitHub</a>
        </div>
        <div class="footer-info-col">
          <span class="footer-heading">Contact</span>
          <a href="mailto:contact@solvepao.com">contact@solvepao.com</a>
          <p>© {year} SolvePao Research</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cleanoli-accent: #111111;
    --cleanoli-accent-light: #5f5f5f;
    --cleanoli-success: #2f2f2f;
    --cleanoli-danger: #161616;
    --cleanoli-ink: #0b0b0b;
    --cleanoli-text: #111111;
    --cleanoli-text-muted: #666666;
    --cleanoli-bg: #ffffff;
    --cleanoli-surface: #ffffff;
    --cleanoli-bg-dark: #ffffff;
    --cleanoli-bg-subtle: #f6f6f4;
    --cleanoli-success-wash: #f3f3f1;
    --cleanoli-border: #e6e6e3;
    --cleanoli-shadow: 0 24px 70px rgba(15, 15, 15, 0.09);
    --cleanoli-radius: 28px;

    color-scheme: light;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    color: var(--cleanoli-text);
    background: var(--cleanoli-bg);
    scroll-behavior: smooth;
  }

  * { box-sizing: border-box; }
  html { scroll-padding-top: 110px; }
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: clip;
    background: var(--cleanoli-bg);
    color: var(--cleanoli-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid var(--cleanoli-accent); outline-offset: 3px; }

  .text-accent { color: var(--cleanoli-accent); }
  .text-accent-light { color: var(--cleanoli-accent-light); }

  main,
  .site-header,
  footer .footer-inner {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 18px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    margin-top: 18px;
    padding: 9px 10px 9px 16px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--cleanoli-border);
    border-radius: 999px;
    box-shadow: 0 14px 40px rgba(15, 15, 15, 0.1);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    color: var(--cleanoli-text);
    font-size: 16px;
    font-weight: 760;
    letter-spacing: -0.025em;
    text-decoration: none;
  }
  .brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    box-shadow: 0 7px 18px var(--cleanoli-bg-subtle);
  }
  nav { display: flex; align-items: center; gap: 6px; }
  nav a {
    padding: 8px 11px;
    border-radius: 9px;
    color: var(--cleanoli-text-muted);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover { color: var(--cleanoli-accent); background: var(--cleanoli-bg-subtle); }
  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--cleanoli-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 760;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s, opacity 0.15s;
  }
  .header-cta:hover { transform: translateY(-1px); opacity: 0.92; }
  .menu-toggle {
    display: none;
    padding: 7px;
    background: transparent;
    border: 0;
    border-radius: 9px;
    color: var(--cleanoli-text);
    cursor: pointer;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin: 0 0 24px;
    padding: 7px 12px;
    background: var(--cleanoli-bg-subtle);
    border: 1px solid color-mix(in srgb, var(--cleanoli-accent) 28%, transparent);
    border-radius: 999px;
    color: var(--cleanoli-accent);
    font-size: 11px;
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow i {
    width: 7px;
    height: 7px;
    background: var(--cleanoli-success);
    border-radius: 50%;
    box-shadow: 0 0 0 5px var(--cleanoli-success-wash);
  }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(58px, 7.4vw, 96px);
    line-height: 0.93;
    letter-spacing: -0.068em;
  }
  h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -0.052em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 50px;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 760;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s, background 0.18s, border-color 0.18s;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--cleanoli-accent); box-shadow: 0 14px 28px var(--cleanoli-bg-subtle); }
  .button-outline { color: var(--cleanoli-text); background: var(--cleanoli-surface); border-color: var(--cleanoli-border); }
  .button-outline:hover { border-color: var(--cleanoli-accent); }
  .button-light { color: #fff; background: #111; }
  .button-ghost { color: #111; background: #fff; border-color: var(--cleanoli-border); }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 54px;
    min-height: 0;
    padding: 112px 0 84px;
    text-align: center;
  }
  .hero-copy { position: relative; z-index: 2; display: flex; align-items: center; flex-direction: column; }
  .lede {
    max-width: 610px;
    margin: 28px 0 0;
    color: var(--cleanoli-text-muted);
    font-size: 17px;
    line-height: 1.75;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; }

  .hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 590px;
    overflow: hidden;
    border-radius: 44px;
    isolation: isolate;
  }
  .hero-stage::before {
    position: absolute;
    inset: 5% 3%;
    z-index: -3;
    background:
      radial-gradient(circle at 25% 20%, var(--cleanoli-bg-subtle), transparent 38%),
      radial-gradient(circle at 72% 80%, var(--cleanoli-success-wash), transparent 40%),
      color-mix(in srgb, var(--cleanoli-surface) 84%, transparent);
    border: 1px solid var(--cleanoli-border);
    border-radius: 44px;
    box-shadow: var(--cleanoli-shadow);
    content: "";
    transform: rotate(2deg);
  }
  .stage-grid {
    position: absolute;
    inset: 10%;
    z-index: -2;
    opacity: 0.25;
    background-image:
      linear-gradient(var(--cleanoli-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--cleanoli-border) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle, #000 25%, transparent 76%);
  }
  .stage-orbit { position: absolute; z-index: -1; border: 1px solid var(--cleanoli-border); border-radius: 50%; }
  .orbit-one { width: 430px; height: 430px; }
  .orbit-two { width: 520px; height: 520px; opacity: 0.55; }
  .cleaner-window {
    width: min(390px, 78%);
    overflow: hidden;
    background: var(--cleanoli-surface);
    border: 7px solid color-mix(in srgb, var(--cleanoli-ink) 90%, #000);
    border-radius: 30px;
    box-shadow: 0 38px 80px -24px color-mix(in srgb, var(--cleanoli-ink) 40%, transparent);
    transform: rotate(-3deg);
  }
  .window-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    background: color-mix(in srgb, var(--cleanoli-bg) 78%, var(--cleanoli-surface));
    border-bottom: 1px solid var(--cleanoli-border);
    font-size: 10px;
  }
  .window-bar strong { font-size: 11px; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots i { width: 7px; height: 7px; background: var(--cleanoli-border); border-radius: 50%; }
  .window-dots i:first-child { background: var(--cleanoli-danger); }
  .window-dots i:nth-child(2) { background: var(--cleanoli-accent); }
  .window-dots i:last-child { background: var(--cleanoli-success); }
  .window-ready { justify-self: end; color: var(--cleanoli-success); font-size: 8px; font-weight: 850; letter-spacing: 0.12em; }
  .window-content { padding: 26px 24px 24px; }
  .window-kicker { color: var(--cleanoli-accent); font-size: 9px; font-weight: 850; letter-spacing: 0.14em; }
  .window-content h3 { margin: 5px 0 22px; font-size: 28px; line-height: 1.04; letter-spacing: -0.045em; }
  .scan-total {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding: 17px;
    background: var(--cleanoli-success-wash);
    border: 1px solid var(--cleanoli-border);
    border-radius: 16px;
  }
  .scan-total span { color: var(--cleanoli-text-muted); font-size: 10px; }
  .scan-total strong { color: var(--cleanoli-success); font-size: 23px; letter-spacing: -0.04em; }
  .clean-row {
    display: grid;
    grid-template-columns: 90px 1fr 48px;
    align-items: center;
    gap: 9px;
    margin-top: 12px;
    color: var(--cleanoli-text-muted);
    font-size: 9px;
  }
  .clean-row strong { color: var(--cleanoli-text); text-align: right; }
  .clean-bar { height: 7px; overflow: hidden; background: var(--cleanoli-border); border-radius: 999px; }
  .clean-bar i { display: block; height: 100%; background: var(--cleanoli-success); border-radius: inherit; }
  .clean-bar-warn i { background: var(--cleanoli-accent); }
  .scan-action {
    display: flex;
    justify-content: space-between;
    margin-top: 22px;
    padding: 12px 14px;
    background: var(--cleanoli-accent);
    border-radius: 11px;
    color: #fff;
    font-size: 11px;
    font-weight: 760;
  }
  .floating-card {
    position: absolute;
    z-index: 4;
    width: 174px;
    padding: 14px;
    background: color-mix(in srgb, var(--cleanoli-surface) 93%, transparent);
    border: 1px solid var(--cleanoli-border);
    border-radius: 14px;
    box-shadow: var(--cleanoli-shadow);
    backdrop-filter: blur(14px);
  }
  .floating-card span, .floating-card strong, .floating-card small { display: block; }
  .floating-card span { color: var(--cleanoli-accent); font-size: 8px; font-weight: 850; letter-spacing: 0.12em; }
  .floating-card strong { margin-top: 4px; font-size: 11px; }
  .floating-card small { margin-top: 2px; color: var(--cleanoli-text-muted); font-size: 9px; }
  .floating-safe { right: -4px; top: 21%; transform: rotate(4deg); }
  .floating-scan { left: -7px; bottom: 20%; transform: rotate(-5deg); }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-bottom: 84px;
    background: var(--cleanoli-border);
    border: 1px solid var(--cleanoli-border);
    border-radius: 24px;
    box-shadow: var(--cleanoli-shadow);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    min-height: 150px;
    padding: 28px 16px;
    background: var(--cleanoli-surface);
    text-align: center;
  }
  .stat-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 3px;
    background: var(--cleanoli-bg-subtle);
    border-radius: 13px;
    line-height: 0;
  }
  .stat-value { font-size: 19px; font-weight: 800; letter-spacing: -0.035em; }
  .stat-label { color: var(--cleanoli-text-muted); font-size: 12px; }

  .features {
    padding: 92px 64px;
    background: #fafaf8;
    border: 1px solid var(--cleanoli-border);
    border-radius: 32px;
  }
  .features-header { max-width: 820px; margin-bottom: 46px; }
  .features-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .feature-card {
    min-height: 250px;
    padding: 28px;
    background: var(--cleanoli-surface);
    border: 1px solid var(--cleanoli-border);
    border-radius: 24px;
    box-shadow: 0 14px 42px rgba(15, 15, 15, 0.06);
    transition: transform 0.18s, border-color 0.18s;
  }
  .feature-card:first-child { background: linear-gradient(135deg, var(--cleanoli-bg-subtle), var(--cleanoli-surface) 62%); }
  .feature-card:nth-child(2) { background: linear-gradient(135deg, var(--cleanoli-success-wash), var(--cleanoli-surface) 66%); }
  .feature-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--cleanoli-accent) 42%, var(--cleanoli-border)); }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: var(--cleanoli-bg-subtle);
    border-radius: 14px;
    line-height: 0;
  }
  .feature-card h3 { margin: 30px 0 8px; font-size: 20px; letter-spacing: -0.03em; }
  .feature-card p { max-width: 510px; margin: 0; color: var(--cleanoli-text-muted); font-size: 14px; line-height: 1.68; }

  .how-it-works { padding: 100px 0; }
  .how-header { max-width: 780px; margin-bottom: 44px; }
  .how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 42px; }
  .how-step {
    padding: 26px 24px;
    background: var(--cleanoli-surface);
    border: 1px solid var(--cleanoli-border);
    border-radius: 20px;
  }
  .step-num {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 25px;
    background: var(--cleanoli-accent);
    border-radius: 12px;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }
  .step-icon { display: none; }
  .how-step h3 { margin: 0 0 8px; font-size: 17px; letter-spacing: -0.025em; }
  .how-step p { margin: 0; color: var(--cleanoli-text-muted); font-size: 13px; line-height: 1.65; }
  .how-command {
    max-width: 850px;
    padding: 28px;
    background: #fff;
    border: 1px solid var(--cleanoli-border);
    border-radius: 22px;
    color: var(--cleanoli-text);
  }
  .how-command-label { margin: 0 0 12px; color: var(--cleanoli-text-muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .code-row { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 18px; background: var(--cleanoli-bg-subtle); border: 1px solid var(--cleanoli-border); border-radius: 13px; }
  .code-row code { flex: 1; min-width: 0; overflow-x: auto; color: var(--cleanoli-text); font-size: 12px; white-space: nowrap; }
  .code-row button { flex-shrink: 0; padding: 9px 14px; background: var(--cleanoli-accent); border: 0; border-radius: 9px; color: #fff; font: inherit; font-size: 12px; font-weight: 760; cursor: pointer; }
  .command-details { margin: 16px 0 0; padding-left: 18px; color: var(--cleanoli-text-muted); font-size: 12px; line-height: 1.85; }
  .command-details code { color: var(--cleanoli-text); }

  .faq { padding: 96px 0; }
  .faq-header { max-width: 760px; margin-bottom: 40px; }
  .faq-list { max-width: 800px; }
  .faq-item { margin-bottom: 12px; padding: 0 22px; background: var(--cleanoli-surface); border: 1px solid var(--cleanoli-border); border-radius: 16px; }
  .faq-btn { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; padding: 20px 0; background: transparent; border: 0; color: var(--cleanoli-text); text-align: left; font: inherit; cursor: pointer; }
  .faq-question { font-size: 15px; font-weight: 700; }
  .faq-chevron { flex-shrink: 0; color: var(--cleanoli-accent); transition: transform 0.22s; }
  .faq-open .faq-chevron { transform: rotate(180deg); }
  .faq-answer { padding: 0 0 20px; }
  .faq-answer p { margin: 0; color: var(--cleanoli-text-muted); font-size: 14px; line-height: 1.7; }

  .bottom-cta {
    margin-bottom: 96px;
    padding: 74px 30px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--cleanoli-border);
    box-shadow: var(--cleanoli-shadow);
    border-radius: 30px;
    color: var(--cleanoli-text);
    text-align: center;
  }
  .bottom-cta-inner { max-width: 680px; margin: auto; }
  .bottom-cta h2 { font-size: clamp(42px, 6vw, 68px); }
  .bottom-cta-text { margin: 18px 0 0; color: var(--cleanoli-text-muted); font-size: 16px; }
  .bottom-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }

  footer { padding: 0 0 46px; }
  .footer-inner { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-top: 42px; border-top: 1px solid var(--cleanoli-border); }
  .footer-brand { display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 760; }
  .footer-brand img { border-radius: 7px; }
  .footer-tagline { margin: 8px 0 0; color: var(--cleanoli-text-muted); font-size: 13px; }
  .footer-heading { display: block; margin-bottom: 12px; color: var(--cleanoli-text-muted); font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .footer-links-col, .footer-info-col { display: flex; flex-direction: column; gap: 7px; }
  .footer-links-col a { color: var(--cleanoli-text-muted); font-size: 13px; text-decoration: none; }
  .footer-links-col a:hover { color: var(--cleanoli-accent); }
  .footer-info-col p { margin: 0; color: var(--cleanoli-text-muted); font-size: 12px; }
  .footer-info-col a { color: var(--cleanoli-text-muted); font-size: 13px; text-decoration: none; }
  .footer-info-col a:hover { color: var(--cleanoli-accent); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 74px; text-align: center; }
    .hero-copy { display: flex; flex-direction: column; align-items: center; }
    .actions { justify-content: center; }
    .hero-stage { min-height: 570px; }
    .features { padding-inline: 34px; }
    .features-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 760px) {
    main, .site-header, footer .footer-inner { width: min(100% - 24px, 1180px); }
    html { scroll-padding-top: 88px; }
    .site-header { top: 8px; min-height: 58px; margin-top: 8px; padding: 8px 10px 8px 13px; border-radius: 24px; flex-wrap: wrap; }
    .brand { font-size: 14px; }
    .brand-icon { width: 32px; height: 32px; border-radius: 10px; }
    .menu-toggle { display: block; }
    .header-cta { display: none; }
    nav { display: none; width: 100%; padding: 8px 0 4px; border-top: 1px solid var(--cleanoli-border); flex-direction: column; align-items: stretch; }
    nav.nav-visible { display: flex; }
    nav a { padding: 10px 4px; }

    .hero { padding-top: 62px; padding-bottom: 50px; }
    h1 { font-size: clamp(48px, 14vw, 72px); }
    h2 { font-size: clamp(36px, 11vw, 52px); }
